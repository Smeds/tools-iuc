<tool id="pairtools_dedup" name="Pairtools dedup" version="@TOOL_VERSION@+galaxy@SUFFIX_VERSION@" profile="23.2" license="MIT">
    <description>Find and remove PCR/optical duplicates</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
        #if $pairs_path.is_of_type('4dn_pairs.gz') or $pairs_path.is_of_type('4dn_pairsam.gz'):
            #set $input_temp = "input.gz"
        #else
            #set $input_temp = "input"
        #end if
        ln -s '$pairs_path' '$input_temp' &&

        #set $output_dedup_pairs_temp = "output_dedup_pairs" + str($compress_output)
        ln -s '$output_dedup_pairs' '$output_dedup_pairs_temp' &&
        #if $output_dups
            #set $output_dups_temp = "output_dups" + str($compress_output)
            ln -s '$output_dups_pairs' '$output_dups_temp' &&
        #end if
        #if $output_stats
            #set $output_stats_temp = "output_stats" + str($compress_output)
            ln -s '$dedup_pairs_stats' '$output_stats_temp' &&
        #end if

        pairtools dedup
            '$input_temp'
            -o '$output_dedup_pairs_temp'
            #if $output_dups:
                --output-dups '$output_dups_temp'
            #end if
            $mark_dups
            #if $output_stats:
                  --output-stats '$output_stats_temp'
            #end if
            --nproc-in \${GALAXY_SLOTS:-4}
            --nproc-out \${GALAXY_SLOTS:-4}
    ]]></command>
    <inputs>      
        <param name="pairs_path" type="data" format="4dn_pairs,4dn_pairsam,4dn_pairs.gz,4dn_pairsam.gz" label="Input pairs file" help="Input triu-flipped sorted .pairs or .pairsam file"/>
        <param argument="--mark-dups" type="boolean" truevalue="--mark-dups" falsevalue="" checked="True" label="Duplicate pairs are marked as DD in pair_type and as a duplicate in the SAM entries"/>
        <param argument="--output-dups" type="boolean" truevalue="--output-dups" falsevalue="" checked="False" label="Output file for duplicate pairs"/>
        <param argument="--output-stats" type="boolean" truevalue="--output-stats" falsevalue="" checked="False" label="Output file for duplicate statistics"/>
        <param name="compress_output" type="boolean" truevalue=".gz" falsevalue="" checked="false" label="Compress output files" />
        
        <conditional name="compress_output">
            <when value="true">
                <conditional name="pairs_path.ext">
                    <when value="4dn_pairs">
                        <param name="format_combo" type="hidden" value="4dn_pairs.gz"/>
                    </when>
                    <when value="4dn_pairsam">
                        <param name="format_combo" type="hidden" value="4dn_pairsam.gz"/>
                    </when>
                </conditional>
            </when>
            <when value="false">
                <conditional name="pairs_path.ext">
                    <when value="4dn_pairs">
                        <param name="format_combo" type="hidden" value="4dn_pairs"/>
                    </when>
                    <when value="4dn_pairsam">
                        <param name="format_combo" type="hidden" value="4dn_pairsam"/>
                    </when>
                </conditional>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="output_dedup_pairs" format_source="pairs_path" label="${tool.name} on ${on_string}: Deduplicated Pairs">
            <change_format>
                <when input="compress_output" value="true"
                    input_dataset="pairs_path" input_attribute="ext" input_value="4dn_pairs">
                    4dn_pairs.gz
                </when>
                <when input="compress_output" value="true"
                    input_dataset="pairs_path" input_attribute="ext" input_value="4dn_pairsam">
                    4dn_pairs.gz
                </when>
                <when input="compress_output" value="false"
                    input_dataset="pairs_path" input_attribute="ext" input_value="4dn_pairs.gz">
                    4dn_pairs
                </when>
                <when input="compress_output" value="false"
                    input_dataset="pairs_path" input_attribute="ext" input_value="4dn_pairsam.gz">
                    4dn_pairs
                </when>
            </change_format>
        </data>
        <data name="output_dups_pairs" format_source="pairs_path" label="${tool.name} on ${on_string}: Duplicate Pairs">
            <filter>output_dups</filter>
            <change_format>
                <when input="format_combo" value="4dn_pairs.gz" format="4dn_pairs.gz" />
                <when input="format_combo" value="4dn_pairsam.gz" format="4dn_pairsam.gz" />
                <when input="format_combo" value="4dn_pairs" format="4dn_pairs" />
                <when input="format_combo" value="4dn_pairsam" format="4dn_pairsam" />
            </change_format>
        </data>
        <data name="dedup_pairs_stats" format="tabular" label="${tool.name} on ${on_string}: Deduplicated stats">
            <filter>output_stats</filter>
            <change_format>
                <when input="compress_output" value=".gz" format="tabular.gz" />
            </change_format>
        </data>
    </outputs>
    <tests>
        <!--Test 01 with default parameters-->
        <test expect_num_outputs="1">
            <param name="pairs_path" ftype="4dn_pairsam" file="output_dedup_pairs.pairsam" value="output_sorted_pairs.pairsam"/>
            <output name="output_dedup_pairs" ftype="4dn_pairsam" file="output_dedup_pairs.pairsam" lines_diff="20"/>
        </test>
        <!--Test 02 mark_dups enabled and output_dups-->
        <test expect_num_outputs="2">
            <param name="pairs_path" ftype="4dn_pairsam" value="output_sorted_pairs.pairsam"/>
            <param name="mark_dups" value="true"></param>
            <param name="output_dups" value="true"></param>
            <output name="output_dedup_pairs" ftype="4dn_pairsam" file="output_dedup_pairs_markdups.pairsam" lines_diff="20"/>
            <output name="output_dups_pairs" ftype="4dn_pairsam"  file="output_dups_pairs_markdups.pairsam" lines_diff="20"/>
        </test>
        <!--Test 03 mark_dups and output_stats enabled-->
        <test expect_num_outputs="2">
            <param name="pairs_path" ftype="4dn_pairsam" value="output_sorted_pairs.pairsam"/>
            <param name="mark_dups" value="true"></param>
            <param name="output_stats" value="true"></param>
            <output name="output_dedup_pairs" ftype="4dn_pairsam" file="output_dedup_pairs_markdups.pairsam" lines_diff="20"/>
            <output name="dedup_pairs_stats" file="output_dedup_pairs.stats" lines_diff="20"/>
        </test>
        <!--Test 04 compressed output -->
        <test expect_num_outputs="3">
            <param name="pairs_path" ftype="4dn_pairsam" value="output_sorted_pairs.pairsam"/>
            <param name="mark_dups" value="true"></param>
            <param name="output_stats" value="true"></param>
            <param name="compress_output" value="true"></param>
            <param name="output_dups" value="true"></param>
            <output name="output_dups_pairs" ftype="4dn_pairsam.gz"  file="output_dups_pairs_markdups.pairsam" decompress="true" lines_diff="20"/>
            <output name="output_dedup_pairs" ftype="4dn_pairsam.gz" file="output_dedup_pairs_markdups.pairsam" decompress="true" lines_diff="20"/>
            <output name="dedup_pairs_stats" file="output_dedup_pairs.stats" decompress="true" lines_diff="20"/>
        </test>
    </tests>
    <help><![CDATA[
        **Pairtools dedup**

        Find PCR/optical duplicates in an upper-triangular flipped sorted pairs/pairsam file. Allow for a +/-N bp mismatch at each side of duplicated molecules.
              
    ]]></help>
    <expand macro="citations"/>
    <expand macro="creator"/>
</tool>
